__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Respaldos rotativos de la base: no versionar
db/backups/
*.db-wal
*.db-shm

# Salidas generadas: se regeneran, no se versionan
outputs/dashboards/*
outputs/excel/*
outputs/informes/*
!outputs/**/.gitkeep

# Crudos pesados. La base .db SI se versiona (es el registro point-in-time).
data/raw/**/*.xls
data/raw/**/*.xlsx
data/raw/**/*.pdf
# Excepcion: las planillas del INE SI se versionan. Son el archivo de
# vintages del IPC (~1-2 MB/mes) y el sandbox de analisis no puede
# descargarlas por si mismo (sin red a ine.gub.uy) ni bajar artifacts
# de Actions (proxy bloquea *.blob.core.windows.net).
!data/raw/ine/**
!data/raw/descubrimiento/**
!data/raw/ims/**

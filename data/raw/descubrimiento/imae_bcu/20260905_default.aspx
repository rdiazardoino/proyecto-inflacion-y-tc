<script type="text/javascript">
    $(document).ready(function () {
        var fechaJs = "05/09/2026";

        function applyResponsivectl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00() {
            const container = document.getElementById("ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items");

            if ($(window).width() <= 767) {
                // 1️Destruir el carrusel de escritorio
                destroyFullCarousel(container);

                // 2️Ocultar columnas sobrantes
                
                $('#ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items .columna').show();

                const elem = buscarColumnaPorFecha(fechaJs).first();
                limitarElementos(elem, '#ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items .columna', 5);

                // 3️Cambiar clases a versión mobile
                $('#ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items')
                    .removeClass('full-slide-carousel-container')
                    .addClass('slide-carousel');

                $('#ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items .items')
                    .removeClass('full-slide-carousel-track')
                    .addClass('carousel-track');

                $('#ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items .grupo')
                    .removeClass('full-slide-carousel-item')
                    .addClass('carousel-item');

                // 4️Esperar al repaint para que los tamaños se actualicen
                requestAnimationFrame(() => {
                    // 5️Inicializar nuevo carrusel mobile
                    initCarousel(container, elem[0]);
                });
            } else {
                // 1️Destruir carrusel mobile
                destroyCarousel(container);

                // 2️Mostrar todas las columnas
                $('#ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items .columna').css('display', 'flex');

                // 3️Cambiar clases a versión escritorio
                $('#ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items')
                    .removeClass('slide-carousel')
                    .addClass('full-slide-carousel-container');

                $('#ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items .items')
                    .removeClass('carousel-track')
                    .addClass('full-slide-carousel-track');

                $('#ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items .grupo')
                    .removeClass('carousel-item')
                    .addClass('full-slide-carousel-item');

                // 4️Esperar al repaint antes de rearmar el carrusel full
                requestAnimationFrame(() => {
                    initFullCarousel(container, 2);
                });
            }
        }


        // Ejecutar al cargar y al redimensionar
        applyResponsivectl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00();
        $(window).resize(applyResponsivectl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00);
    });

    function limitarElementos($current, selector = '.dot', max = 5) {
        const $all = $(selector);
        const index = $all.index($current);

        if (index === -1) return;

        const half = Math.floor(max / 2);

        let start = index - half;
        let end = index + half;

        // Ajustar límites
        if (start < 0) {
            end += Math.abs(start);
            start = 0;
        }

        if (end >= $all.length) {
            start -= end - ($all.length - 1);
            end = $all.length - 1;
        }

        start = Math.max(0, start);

        // Ocultar todos
        $all.hide();

        // Mostrar solo la ventana
        $all.slice(start, end + 1).show();
    }


    function parseFecha(str) {
        const [d, m, y] = str.split('/');
        //return new Date(`${y}-${m}-${d}`);
        return new Date(y, m - 1, d);
    }

    function formatFecha(date) {
        let d = String(date.getDate()).padStart(2, '0');
        let m = String(date.getMonth() + 1).padStart(2, '0');
        let y = date.getFullYear();
        return `${d}/${m}/${y}`;
    }

    function buscarColumnaPorFecha(fechaInicial) {

        let fecha = parseFecha(fechaInicial);

        // 1️⃣ Obtener la fecha máxima de todos los div visibles
        let maxFecha = null;
        let ultimoDivVisible = null;

        $("#ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items .columna:visible").each(function () {

            ultimoDivVisible = $(this); // si no hay match, este será el fallback

            $(this).data("dates").split(",").forEach(f => {
                let fDate = parseFecha(f.trim());
                if (!maxFecha || fDate > maxFecha) {
                    maxFecha = fDate;
                }
            });
        });

        if (!maxFecha) return null; // no hay columnas visibles

        // 2️⃣ Buscar la fecha avanzando día a día
        while (fecha <= maxFecha) {
            let fechaStr = formatFecha(fecha);

            let match = $("#ctl00_ctl66_g_893b02d9_f075_4544_8f6e_be3b77a54ecd_ctl00_items .columna:visible").filter(function () {
                let dates = $(this).data("dates").split(",").map(x => x.trim());
                return dates.includes(fechaStr);
            });

            if (match.length > 0) {
                return match;  // Devuelvo el div encontrado
            }

            // Avanzar 1 día
            fecha.setDate(fecha.getDate() + 1);
        }

        // 3️⃣ Si no se encontró nada, devolver el último visible
        return ultimoDivVisible;
    }


</script>

